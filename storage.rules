rules_version = '2';
// Deploy: firebase deploy --only storage — or paste in Console → Storage → Rules.
// Allows the admin UID from Firestore admin_configs/global to write project media.
// Public read matches previously API-uploaded files.

service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/{mediaKind}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (mediaKind == "images" || mediaKind == "videos")
        && request.auth.uid == firestore.get(
          /databases/(default)/documents/admin_configs/global
        ).data.adminUid;
    }
  }
}
